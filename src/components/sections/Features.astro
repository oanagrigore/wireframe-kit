---
/**
 * Features — 8 layouts.
 *   grid-3           3-column cards
 *   grid-2           2-column cards
 *   icons-4          4 icons, no cards
 *   bento            Bento
 *   list             Icon list
 *   zigzag           Alternating rows
 *   steps            Steps
 *   tabs             Tabs
 *
 * Props: variant, tone ('base' | 'muted' | 'primary').
 * Styles come from src/styles/wireframe.css and the tokens on the parent .wf element.
 */
export type FeaturesVariant = 'grid-3' | 'grid-2' | 'icons-4' | 'bento' | 'list' | 'zigzag' | 'steps' | 'tabs';
interface Props {
  variant?: FeaturesVariant;
  tone?: 'base' | 'muted' | 'primary';
}
const { variant = 'grid-3', tone = 'base' } = Astro.props;
---
<section class:list={['wf-sec', tone !== 'base' && `tone-${tone}`]} data-type="features" data-variant={variant}>
  {variant === 'grid-3' && (
    <Fragment>
      <div class="wf-in">
        <div class="wf-head center">
          <span class="wf-eyebrow">Features</span>
          <h2>Section headline that groups the benefits</h2>
          <p class="wf-lead">A sentence that tells the reader why these belong together.</p>
        </div>
        <div class="wf-grid c3">
          <div class="wf-card">
            <span class="wf-icon">
            </span>
            <h3>Faster setup</h3>
            <p class="wf-muted">Describe the result first, then the feature that makes it possible.</p>
          </div>
          <div class="wf-card">
            <span class="wf-icon">
            </span>
            <h3>Fewer handoffs</h3>
            <p class="wf-muted">One sentence on the problem this removes from the customer’s week.</p>
          </div>
          <div class="wf-card">
            <span class="wf-icon">
            </span>
            <h3>Clear reporting</h3>
            <p class="wf-muted">Name the decision this helps them make, not the chart it shows.</p>
          </div>
          <div class="wf-card">
            <span class="wf-icon">
            </span>
            <h3>Works with your stack</h3>
            <p class="wf-muted">List the two or three integrations your buyers ask about most.</p>

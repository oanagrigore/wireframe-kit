          <div class="wf-card">
            <span class="wf-icon">
            </span>
            <h3>Built for teams</h3>
            <p class="wf-muted">Who uses it day to day, and what changes for their manager.</p>
          </div>
          <div class="wf-card">
            <span class="wf-icon">
            </span>
            <h3>Secure by default</h3>
            <p class="wf-muted">The proof point procurement looks for: a standard, a certification.</p>
          </div>
        </div>
      </div>
    </Fragment>
  )}

---
/**
 * Logo cloud — 4 layouts.
 *   row              Row
 *   inline           Caption left
 *   boxed            Boxed grid
 *   divided          Divided grid
 *
 * Props: variant, tone ('base' | 'muted' | 'primary').
 * Styles come from src/styles/wireframe.css and the tokens on the parent .wf element.
 */
export type LogoCloudVariant = 'row' | 'inline' | 'boxed' | 'divided';
interface Props {
  variant?: LogoCloudVariant;
  tone?: 'base' | 'muted' | 'primary';
}
const { variant = 'row', tone = 'base' } = Astro.props;
---
<section class:list={['wf-sec', tone !== 'base' && `tone-${tone}`]} data-type="logos" data-variant={variant}>
  {variant === 'row' && (
    <Fragment>
      <div class="wf-in">
        <p class="wf-small wf-muted" style="text-align:center;margin-bottom:calc(var(--gap) * 1.25)">Trusted by teams at</p>
        <div class="wf-logos">
          <span class="wf-logo-ph">
          </span>
          <span class="wf-logo-ph">
          </span>
          <span class="wf-logo-ph">
          </span>
          <span class="wf-logo-ph">
          </span>
          <span class="wf-logo-ph">
          </span>
          <span class="wf-logo-ph">
          </span>
        </div>
      </div>
    </Fragment>
  )}
  {variant === 'inline' && (
    <Fragment>
      <div class="wf-in wf-logos-inline">
        <p class="wf-small wf-muted">Trusted by 120+ teams, from startups to scale-ups</p>
        <div class="wf-logos">
          <span class="wf-logo-ph">
          </span>
          <span class="wf-logo-ph">
          </span>
          <span class="wf-logo-ph">
          </span>
          <span class="wf-logo-ph">
          </span>
          <span class="wf-logo-ph">
          </span>
        </div>
      </div>
    </Fragment>
  )}
  {variant === 'boxed' && (
    <Fragment>
      <div class="wf-in">
        <p class="wf-small wf-muted" style="text-align:center;margin-bottom:calc(var(--gap) * 1.25)">Trusted by teams at</p>
        <div class="wf-logos boxed">
          <div>
            <span class="wf-logo-ph">
            </span>
          </div>
          <div>
            <span class="wf-logo-ph">
            </span>
          </div>
          <div>
            <span class="wf-logo-ph">
            </span>
          </div>
          <div>
            <span class="wf-logo-ph">
            </span>
          </div>
          <div>
            <span class="wf-logo-ph">
            </span>
          </div>
          <div>
            <span class="wf-logo-ph">
            </span>
          </div>
          <div>
            <span class="wf-logo-ph">
            </span>
          </div>
          <div>
            <span class="wf-logo-ph">
            </span>
          </div>
        </div>
      </div>
    </Fragment>
  )}
  {variant === 'divided' && (
    <Fragment>
      <div class="wf-in">
        <p class="wf-small wf-muted" style="text-align:center;margin-bottom:calc(var(--gap) * 1.25)">Trusted by teams at</p>
        <div class="wf-logos divided">
          <div>
            <span class="wf-logo-ph">
            </span>
          </div>
          <div>
            <span class="wf-logo-ph">
            </span>
          </div>
          <div>
            <span class="wf-logo-ph">
            </span>
          </div>
          <div>
            <span class="wf-logo-ph">
            </span>
          </div>
          <div>
            <span class="wf-logo-ph">
            </span>
          </div>
          <div>
            <span class="wf-logo-ph">
            </span>
          </div>
        </div>
      </div>
    </Fragment>
  )}
</section>

---
/**
 * The editor. Every section layout is rendered here at build time from the Astro
 * components in src/components/sections, into <template> elements the editor clones.
 */
import { Navbar, Hero, LogoCloud, Features, FeatureSplit, Stats, CaseStudies, Testimonials, Pricing, Faq, CallToAction, Footer } from '../components/sections';
import catalog from '../data/catalog.json';
import wfCss from '../styles/wireframe.css?raw';
import '../styles/editor.css';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Wireframe Kit · Oana Grigore</title>
<meta name="description" content="A visual page builder for copywriters, product managers and founders: put your copy and page order into 66 responsive sections, try versions fast, and hand designers a clear starting point.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22%3E%3Crect width=%2232%22 height=%2232%22 rx=%226%22 fill=%22%231f3a8a%22/%3E%3Cpath d=%22M8 9h16M8 16h10M8 23h13%22 stroke=%22%23fff%22 stroke-width=%223%22 stroke-linecap=%22round%22/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300..800&family=Geist:wght@300..800&family=Inter:wght@300..800&family=DM+Sans:wght@300..800&family=Manrope:wght@300..800&family=Fraunces:wght@300..800&family=Instrument+Serif&family=Bricolage+Grotesque:wght@300..800&family=Newsreader:wght@300..800&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" />
<style id="wfcss" is:inline set:html={wfCss}></style>
</head>
<body>
<div class="app">
  <div class="topbar">
    <div class="brand"><span><a class="crumb" href="https://ogrigore.design">Oana Grigore</a> / Wireframe Kit</span></div>
    <div class="seg" role="group" aria-label="Preview width">
      <button data-vp="desktop" aria-pressed="true">Desktop<span class="w">fluid</span></button>
      <button data-vp="tablet" aria-pressed="false">Tablet<span class="w">834</span></button>
      <button data-vp="mobile" aria-pressed="false">Mobile<span class="w">390</span></button>
    </div>
    <button class="btn a11y-pill" id="a11yBtn" data-state=""><i></i><span>Checking contrast</span></button>
    <span class="edit-hint">Click any text to edit it</span>
    <div class="menu" id="moreMenu">
      <button class="btn menu-btn" id="moreBtn" aria-expanded="false" aria-controls="moreList">More exports<span class="chev" aria-hidden="true"></span></button>
      <div class="menu-list" id="moreList" hidden>
        <button class="menu-item" id="exportCopy">Copy deck<small>Every line of text, labelled</small></button>
        <button class="menu-item" id="exportCss">Design tokens<small>CSS variables + Tailwind</small></button>
        <button class="menu-item" id="exportHtml">HTML page<small>Standalone, with your copy</small></button>
      </div>
    </div>
    <button class="btn pri" id="exportAstro">Export Astro page</button>
  </div>

  <aside class="rail">
    <div class="tabs" role="tablist">
      <button role="tab" aria-selected="true" data-tab="theme">Theme</button>
      <button role="tab" aria-selected="false" data-tab="sections">Sections</button>
      <button role="tab" aria-selected="false" data-tab="a11y">Accessibility<span class="cnt" id="a11yCnt" hidden></span></button>
    </div>
    <div class="pane" id="pane-theme"></div>
    <div class="pane" id="pane-sections" hidden></div>
    <div class="pane" id="pane-a11y" hidden></div>
  </aside>

  <main class="canvas">
    <div class="frame" id="frame" data-vp="desktop"><div class="wf" id="wf"></div></div>
  </main>
</div>

<div class="modal" id="modal" hidden>
  <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="mTitle">
    <header><h2 id="mTitle">Export</h2><button class="btn pri" id="mCopy">Copy</button><button class="btn" id="mClose">Close</button></header>
    <textarea id="mText" spellcheck="false" readonly aria-label="Export code"></textarea>
    <footer id="mNote"></footer>
  </div>
</div>
<div class="modal picker" id="picker" hidden>
  <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="pTitle">
    <header><h2 id="pTitle">Layouts</h2><span class="psub" id="pSub"></span><button class="btn" id="pClose">Close</button></header>
    <div class="pgrid" id="pGrid"></div>
  </div>
</div>
<div class="toast" id="toast" hidden></div>

<div hidden>
  {Object.keys(catalog[0].variants).map((v) => <template data-wf={`nav:${v}`}><Navbar variant={v as any} /></template>)}
  {Object.keys(catalog[1].variants).map((v) => <template data-wf={`hero:${v}`}><Hero variant={v as any} /></template>)}
  {Object.keys(catalog[2].variants).map((v) => <template data-wf={`logos:${v}`}><LogoCloud variant={v as any} /></template>)}
  {Object.keys(catalog[3].variants).map((v) => <template data-wf={`features:${v}`}><Features variant={v as any} /></template>)}
  {Object.keys(catalog[4].variants).map((v) => <template data-wf={`split:${v}`}><FeatureSplit variant={v as any} /></template>)}
  {Object.keys(catalog[5].variants).map((v) => <template data-wf={`stats:${v}`}><Stats variant={v as any} /></template>)}
  {Object.keys(catalog[6].variants).map((v) => <template data-wf={`cards:${v}`}><CaseStudies variant={v as any} /></template>)}
  {Object.keys(catalog[7].variants).map((v) => <template data-wf={`testimonials:${v}`}><Testimonials variant={v as any} /></template>)}
  {Object.keys(catalog[8].variants).map((v) => <template data-wf={`pricing:${v}`}><Pricing variant={v as any} /></template>)}
  {Object.keys(catalog[9].variants).map((v) => <template data-wf={`faq:${v}`}><Faq variant={v as any} /></template>)}
  {Object.keys(catalog[10].variants).map((v) => <template data-wf={`cta:${v}`}><CallToAction variant={v as any} /></template>)}
  {Object.keys(catalog[11].variants).map((v) => <template data-wf={`footer:${v}`}><Footer variant={v as any} /></template>)}
</div>

<script>
  import '../scripts/editor.js';
</script>
</body>
</html>
